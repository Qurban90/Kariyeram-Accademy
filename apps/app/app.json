{
  "expo": {
    "name": "Karyeram Accademy",
    "slug": "karyeram-accademy",
    "scheme": "karyeram",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0A09"
    },
    "ios": {
      "bundleIdentifier": "az.karyeram.accademy",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Canlı dərsdə müəllim və icazə verilən tələbələr kameradan istifadə edir.",
        "NSMicrophoneUsageDescription": "Canlı dərsdə söz verildikdə danışmaq üçün mikrofon lazımdır."
      }
    },
    "android": {
      "package": "az.karyeram.accademy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0A09"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
