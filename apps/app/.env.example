# Supabase layihəsi (Settings → API). Anon açar ictimaidir; service_role HEÇ VAXT bura yazılmır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Giriş üsulları: "phone,email" (defolt), yalnız "email" və ya yalnız "phone".
# SMS provayderi qoşulmayıbsa "email" yazın — telefon OTP işləməyəcək.
EXPO_PUBLIC_AUTH_METHODS=phone,email

# Diaqnostika nişanı (crumb loglarında görünür): məs. "pilot1", "store1". Verilməsə "dev".
EXPO_PUBLIC_BUILD=dev

# Yalnız veb export üçün (GitHub Pages alt-qovluğunda yerləşdiriləndə, məs. "/Kariyeram-Accademy").
# Native buildə təsiri yoxdur; lokalda lazımsızdır.
# EXPO_BASE_URL=