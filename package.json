{
  "name": "karyeram-academy",
  "private": true,
  "version": "0.1.0",
  "description": "Karyeram Academy: virtual m\u0259kt\u0259b (\u00f6z\u00fcn\u00fc \u00f6yr\u0259nm\u0259 otaqlar\u0131, canl\u0131 d\u0259rs, qorunan test bank\u0131)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/app --noEmit",
    "db:test": "bash supabase/tests/run.sh",
    "test:int": "bash tests/integration/run.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "import:questions": "node scripts/import-questions.mts"
  },
  "devDependencies": {
    "supabase": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
